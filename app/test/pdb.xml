<?xml version="1.0" encoding="UTF-8"?>
<pdb url="postgres://app:app@127.0.0.1:6432/gamedb?sslmode=disable"
     genOutput="./ptable"
     schema="public"
     poolMaxConns="100" poolMinConns="10"
     poolMaxConnLifetime="3600" poolMaxConnIdleTime="1800"
     poolHealthCheckPeriod="60"
     statementTimeoutMs="5000" idleInTransactionSessionTimeoutMs="5000"
     lockTimeoutMs="1000" transactionTimeoutMs="5000"
     showSQL="true"
     appName="lobby-svc">

    <bean name="User">
        <variable name="id" type="int64"/>
        <variable name="name" type="string"/> 角色名
        <variable name="status" type="int16"/> 是否封禁 0正常 1封禁
        <variable name="createdAt" type="int64"/>
        <variable name="lastLoginAt" type="int64"/>
        <variable name="totalCharge" type="int64"/>    累计充值
        <variable name="firstChargeAt" type="int64"/>     0 = 未首充
        <variable name="requestToken" type="string"/> 每次请求轮换
    </bean>
    <table name="user" bean="User">
        <primaryKey variable="id" autoIncrement="true" start="1000"/>
    </table>

    <bean name="UserIdentity"> 第三方身份绑定 (sdk登录用)
        <variable name="id" type="int64"/>
        <variable name="platform" type="int16"/> 平台枚举
        <variable name="platformUID" type="string"/> 平台返回的open_id 内网测试则是手填的账号/邀请码
        <variable name="uid" type="int64"/> 关联的uid
        <variable name="createdAt" type="int64"/>
    </bean>
    <table name="user_identity" bean="UserIdentity">
        <primaryKey variable="id" autoIncrement="true"/>
        <index variable="uid" unique="false"/>
        <index variable="platform,platformUID" unique="true"/>
    </table>

    <bean name="UserRefreshToken"> 免登录token 每个设备一行
        <variable name="id" type="int64"/>
        <variable name="uid" type="int64"/> 关联的uid
        <variable name="deviceId" type="string"/> 设备id
        <variable name="token" type="string"/> refreshToken 每次轮换
        <variable name="prevToken" type="string"/> 上一个token的hash 每次免登录成功轮换token 如果新token丢了 允许一定时间内用旧token
        <variable name="rotatedAt" type="int64"/> 上次轮换时间 用来判断prev是否在宽限期内
        <variable name="expiresAt" type="int64"/> 绝对过期时间 比如创建后30天 每次轮换时延 活跃玩家就不用重新sdk登录
        <variable name="revokedAt" type="int64"/> 非0表示作废 改密码 玩家登出 封禁时设置一下now 新设备因为deviceId不同另起一行 旧设备因为sdk登录会覆盖这一行
    </bean>

    <table name="user_refresh_token" bean="UserRefreshToken">
        <primaryKey variable="id" autoIncrement="true"/>
        <index variable="uid, deviceId" unique="true"/>
        <index variable="token" unique="true"/>
    </table>


    <bean name="RedEnvelope">
        <variable name="id" type="int64"/> 自增
        <variable name="uid" type="int64"/> user id
        <variable name="actId" type="int32"/> 活动id
        <variable name="lastRefreshAt" type="int64"/> 上一次刷新的时间
        <variable name="todayCount" type="int32"/> 今天领了几次
        <variable name="total" type="int32"/> 总共领了几次
    </bean>

    <table name="user_red_envelope" bean="RedEnvelope">
        <primaryKey variable="id" autoIncrement="true"/>
        <index variable="uid,actId" unique="true"/>
    </table>

    <bean name="Mail">
        <variable name="id" type="int64"/> 自增
        <variable name="uid" type="int64"/> user id
        <variable name="confId" type="int32"/> 配置id
        <variable name="state" type="int32"/> 状态
        <variable name="receiveAt" type="int64"/> 收取时间
        <variable name="params" type="string"/> json
        <variable name="awardList" type="string"/> json
    </bean>

    <table name="user_mail" bean="Mail">
        <primaryKey variable="id" autoIncrement="true"/>
        <index variable="uid,confId" unique="false"/>
    </table>

    <bean name="GMMail">
        <variable name="id" type="int64"/> 自增
        <variable name="params" type="string"/> json
        <variable name="awardList" type="string"/> json
        <variable name="startAt" type="int64"/> 开始时间
        <variable name="endAt" type="int64"/> 结束时间
        <variable name="channel" type="string"/> 渠道
        <variable name="userCreatedAt" type="int64"/> 创角时间
        <variable name="condition" type="string"/> 条件 应该需要脚本引擎执行
    </bean>

    <table name="user_gm_mail" bean="GMMail">
        <primaryKey variable="id" autoIncrement="true"/>
    </table>
</pdb>

